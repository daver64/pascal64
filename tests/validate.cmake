function(reject name source expected)
  file(WRITE "${WORK}/${name}.pas" "${source}")
  execute_process(COMMAND "${P64}" "${WORK}/${name}.pas" -o "${WORK}/${name}" --clang "${CLANG}"
                  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT error MATCHES "${expected}")
    message(FATAL_ERROR "${name} should fail with ${expected}: ${output}${error}")
  endif()
endfunction()
