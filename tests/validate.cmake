reject(class_inherited_duplicate "program p; type a = class x: Integer end; b = class(a) x: Integer end; begin end." "duplicate field")
reject(class_downcast "program p; type a = class end; b = class(a) end; var x: a; y: b; begin y := x end." "incompatible assignment")
reject(class_var_upcast "program p; type a = class end; b = class(a) end; var y: b; procedure q(var x: a); begin end; begin q(y) end." "incompatible argument")
reject(class_override_missing "program p; type a = class procedure q; override; end; procedure a.q; begin end; begin end." "override requires an inherited virtual method")
reject(class_override_nonvirtual "program p; type a = class procedure q; end; b = class(a) procedure q; override; end; procedure a.q; begin end; procedure b.q; begin end; begin end." "override requires an inherited virtual method")
reject(class_override_signature "program p; type a = class procedure q(x: Integer); virtual; end; b = class(a) procedure q(x: Int64); override; end; procedure a.q(x: Integer); begin end; procedure b.q(x: Int64); begin end; begin end." "override signature mismatch")
reject(class_virtual_nested "program p; procedure outer; type a = class procedure q; virtual; end; procedure a.q; begin end; begin end; begin end." "virtual methods require a program- or unit-scope class")

file(WRITE "${WORK}/class_nil.pas" "program p; type t = class x: Integer end; var a: t; begin writeln(a.x) end.")
execute_process(COMMAND "${P64}" "${WORK}/class_nil.pas" -o "${WORK}/class_nil" --clang "${CLANG}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "nil class test compilation failed: ${output}${error}")
endif()
execute_process(COMMAND "${WORK}/class_nil" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(result EQUAL 0 OR NOT error MATCHES "nil class instance")
  message(FATAL_ERROR "expected nil class failure (${result}): ${output}${error}")
endif()

file(WRITE "${WORK}/cyclea.pas" "unit cyclea; interface uses cycleb; implementation end.")
file(WRITE "${WORK}/cycleb.pas" "unit cycleb; interface uses cyclea; implementation end.")
file(WRITE "${WORK}/alpha.pas" "unit alpha; interface type shared = Integer; implementation end.")
file(WRITE "${WORK}/beta.pas" "unit beta; interface type shared = Int64; implementation end.")
file(WRITE "${WORK}/wrongname.pas" "unit anothername; interface implementation end.")
file(WRITE "${WORK}/unitbody.pas" "unit unitbody; interface procedure q; implementation end.")
file(WRITE "${WORK}/unitmismatch.pas" "unit unitmismatch; interface procedure q(x: Integer); implementation procedure q(x: Int64); begin end; end.")
file(WRITE "${WORK}/unitprivate.pas" "unit unitprivate; interface implementation var secret: Integer; end.")
file(WRITE "${WORK}/unitdep.pas" "unit unitdep; interface const secret = 1; implementation end.")
file(WRITE "${WORK}/unitiface.pas" "unit unitiface; interface uses unitdep; implementation end.")
file(WRITE "${WORK}/unitimpl.pas" "unit unitimpl; interface procedure q; implementation uses unitdep; procedure q; begin writeln(secret) end; end.")
file(WRITE "${WORK}/unitleak.pas" "unit unitleak; interface const value = secret; implementation uses unitdep; end.")
file(WRITE "${WORK}/unitlocalleak.pas" "unit unitlocalleak; interface const value = secret; implementation const secret = 1; end.")
reject(unit_missing "program p; uses unit_that_does_not_exist; begin end." "cannot find unit")
reject(unit_cycle "program p; uses cyclea; begin end." "circular unit dependency")
reject(unit_ambiguous "program p; uses alpha, beta; var x: shared; begin end." "ambiguous imported identifier")
file(WRITE "${WORK}/ambiga.pas" "unit ambiga; interface var value: Integer; procedure bump; implementation procedure bump; begin value := value + 1 end; end.")
file(WRITE "${WORK}/ambigb.pas" "unit ambigb; interface var value: Integer; procedure bump; implementation procedure bump; begin value := value + 10 end; end.")
file(WRITE "${WORK}/qualified_ambiguous.pas" "program qualified_ambiguous; uses ambiga, ambigb; begin ambiga.bump; ambiga.bump; ambigb.bump; writeln(ambiga.value, ' ', ambigb.value) end.")
execute_process(COMMAND "${P64}" "${WORK}/qualified_ambiguous.pas" -o "${WORK}/qualified-ambiguous-test" --clang "${CLANG}" --unit-path "${WORK}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "qualified ambiguous compilation failed: ${output}${error}")
endif()
execute_process(COMMAND "${WORK}/qualified-ambiguous-test" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(NOT result EQUAL 0 OR NOT output STREQUAL "2 10\n")
  message(FATAL_ERROR "unexpected qualified ambiguous output (${result}): ${output}${error}")
endif()

file(WRITE "${WORK}/iface_dep_b.pas" "unit iface_dep_b; interface type trec = record x: Integer end; procedure bump(var v: trec); implementation procedure bump(var v: trec); begin v.x := v.x + 5 end; end.")
file(WRITE "${WORK}/iface_dep_a.pas" "unit iface_dep_a; interface uses iface_dep_b; const base = 2; implementation end.")
file(WRITE "${WORK}/iface_dep_test.pas" "program iface_dep_test; uses iface_dep_a; var v: iface_dep_b.trec; begin v.x := iface_dep_a.base; iface_dep_b.bump(v); writeln(v.x) end.")
execute_process(COMMAND "${P64}" "${WORK}/iface_dep_test.pas" -o "${WORK}/iface-dep-test" --clang "${CLANG}" --unit-path "${WORK}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
