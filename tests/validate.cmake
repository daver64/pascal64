execute_process(COMMAND "${WORK}/iface-dep-test" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(NOT result EQUAL 0 OR NOT output STREQUAL "7\n")
  message(FATAL_ERROR "unexpected interface dependency output (${result}): ${output}${error}")
endif()
reject(unit_wrong_name "program p; uses wrongname; begin end." "unit name does not match")
