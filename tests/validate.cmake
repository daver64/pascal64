foreach(index IN ITEMS -3 2)
  file(WRITE "${WORK}/array_out_of_bounds.pas" "program p; type t = array[-2..1] of Integer; var a: t; begin writeln(a[${index}]) end.")
  execute_process(COMMAND "${P64}" "${WORK}/array_out_of_bounds.pas" -o "${WORK}/array_out_of_bounds" --clang "${CLANG}"
                  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "bounds test compilation failed: ${output}${error}")
  endif()
  execute_process(COMMAND "${WORK}/array_out_of_bounds" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
  if(result EQUAL 0 OR NOT error MATCHES "array index ${index} outside -2\\.\\.1")
    message(FATAL_ERROR "expected bounds failure (${result}): ${output}${error}")
  endif()
endforeach()
